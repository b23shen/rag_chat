# Copy to .env and fill in. .env is gitignored and never committed.

GEMINI_API_KEY=

# Pin exact versions (no "-latest" aliases) so eval results stay comparable.
# Start with the cheapest models; upgrade one role at a time and measure it.
# Prices are USD per 1M tokens, input / output (ai.google.dev/gemini-api/docs/pricing, Oct 2026).
# `uv run python scripts/smoke_test.py` lists the models your key can use.
# (Comments stay on their own lines: some env-file readers don't strip inline comments.)
# The gemini-2.5 models are closed to new keys ("no longer available to new users").
# Agent loop: cheapest model that works, $0.25 / $1.50
CHAT_MODEL=gemini-3.1-flash-lite
# Used when the chat model fails after retries (e.g. 503 "high demand"): $0.30 / $2.50
CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Input guardrail and fact extraction: $0.25 / $1.50
HELPER_MODEL=gemini-3.1-flash-lite
# Eval judge, one tier above the chat model (a judge shouldn't be weaker than what it grades): $0.75 / $3.75
JUDGE_MODEL=gemini-3.6-flash
# $0.20 per 1M input tokens
EMBED_MODEL=gemini-embedding-2
EMBED_DIMS=1536
# Requests per minute for batch jobs (ingestion, eval); raise it on a paid key.
GEMINI_RPM=10
# Cohere Rerank, for the "rerank" search mode: create a free trial key at dashboard.cohere.com.
# A trial key allows 10 rerank calls a minute and 1,000 a month (about 20 full eval runs).
COHERE_API_KEY=
# rerank-v4.0-pro (quality) or rerank-v4.0-fast (speed); both are multilingual.
RERANK_MODEL=rerank-v4.0-pro
RERANK_RPM=10

# Langfuse tracing: create a free project at cloud.langfuse.com. Leave empty to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Pin "today" (YYYY-MM-DD) for evals, so "now" and "this month" mean the same days on every
# run. Leave empty to use the real date in Taiwan.
# TODAY=2026-10-12

# scripts/init_db.sh fills these in.
PG_HOST=localhost
PG_PORT=5432
PG_USER=promo_rag
PG_PASSWORD=
PG_DB=rag

BLOB_DIR=data/blobs
